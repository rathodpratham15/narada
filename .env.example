# Copy to .env and adjust. Never commit .env. Never put real keys in this file.

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (docker compose maps host port 5433 to avoid clashing with a local Postgres)
DATABASE_URL=postgres://narada:narada@localhost:5433/narada
# Integration tests use a separate database created by the compose init script
TEST_DATABASE_URL=postgres://narada:narada@localhost:5433/narada_test

# Redis (docker compose maps host port 6380; a Homebrew Redis often owns 6379)
REDIS_URL=redis://localhost:6380

# API (bind to localhost: there is no authentication yet, see docs/architecture/risks.md R12)
API_HOST=127.0.0.1
API_PORT=3000

# Embeddings (used from Milestone 3)
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Original uploads are stored here, content-addressed. API and worker MUST share it.
# Relative paths resolve against the repository root.
BLOB_STORE_DIR=.data/blobs

# Upload and extraction limits
MAX_UPLOAD_BYTES=26214400
PDF_MAX_PAGES=2000
EXTRACTION_TIMEOUT_MS=60000

# Chunking (token estimates; see docs/architecture/overview.md)
CHUNK_TARGET_TOKENS=350
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=60

# Ingestion worker
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEARTBEAT_MS=15000
WORKER_STALE_JOB_MS=120000
WORKER_MAX_ATTEMPTS=3
