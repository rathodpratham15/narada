{
  "name": "narada",
  "private": true,
  "version": "0.1.0",
  "description": "Narada Knowledge Engine: provenance-preserving ingestion and retrieval.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker/docker-compose.yml down -v",
    "db:generate": "pnpm --filter @narada/database generate",
    "db:migrate": "pnpm --filter @narada/database migrate",
    "dev:api": "pnpm --filter @narada/api dev",
    "dev:worker": "pnpm --filter @narada/ingestion-worker dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
